---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ChapterProgress from '../../../components/ChapterProgress';
import { categories, chapterSlug, getLibrary, href, type LibraryBook, type Chapter } from '../../../lib/catalog';
export async function getStaticPaths() {
  const books = await getLibrary();
  return books.flatMap(book => book.chapters.map(chapter => ({
    params: { book: book.slug, chapter: chapterSlug(chapter) },
    props: { book, chapter },
  })));
}
const { book, chapter } = Astro.props as { book: LibraryBook; chapter: Chapter };
const { Content } = await render(chapter);
const idx = book.chapters.findIndex(c => c.id === chapter.id);
const prev = book.chapters[idx - 1];
const next = book.chapters[idx + 1];
---
<Base title={chapter.data.title} description={chapter.data.description}>
  <div class="shell reader-shell">
    <aside class="reader-sidebar">
      <a class="back-link" href={href(`books/${book.slug}/`)}>← 책의 목차</a>
      <div class="reader-book-label">{categories[book.category]}</div><h2>{book.title}</h2>
      <div class="reader-toc">{book.chapters.map(item => <a class:list={['toc-link', {current: item.id === chapter.id}]} href={href(`books/${book.slug}/${chapterSlug(item)}/`)} aria-current={item.id === chapter.id ? 'page' : undefined}><span>{String(item.data.chapter).padStart(2,'0')}</span>{item.data.title}</a>)}</div>
    </aside>
    <article class="reader-content">
      <div class="reader-topline"><a href={href(`books/${book.slug}/`)}>{book.title}</a><span>CHAPTER {String(chapter.data.chapter).padStart(2,'0')} / {String(book.chapters.length).padStart(2,'0')}</span></div>
      <header class="article-head"><div class="section-kicker">{chapter.data.minutes} MIN READ</div><h1>{chapter.data.title}</h1><p>{chapter.data.description}</p></header>
      <div class="prose"><Content /></div>
      <div class="reading-actions"><ChapterProgress client:load id={`${book.slug}/${chapterSlug(chapter)}`} /><a href={href(`books/${book.slug}/`)}>전체 목차 ↗</a></div>
      <nav class="reader-pagination" aria-label="챕터 이동"><div>{prev ? <a href={href(`books/${book.slug}/${chapterSlug(prev)}/`)}><small>← 이전 챕터</small><strong>{prev.data.title}</strong></a> : <span></span>}</div><div>{next ? <a href={href(`books/${book.slug}/${chapterSlug(next)}/`)}><small>다음 챕터 →</small><strong>{next.data.title}</strong></a> : <a href={href(`books/${book.slug}/`)}><small>학습 완료</small><strong>목차로 돌아가기 ↗</strong></a>}</div></nav>
    </article>
  </div>
</Base>
